<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cubo_aruco">
    <pose>1.5 0 0.5 0 0 0</pose>

    <link name="link">
      <kinematic>true</kinematic>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00333</ixx>
          <iyy>0.00333</iyy>
          <izz>0.00333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box><size>0.2 0.2 0.2</size></box>
        </geometry>
      </collision>

      <!-- Cuerpo del cubo (5 caras visibles, color simple) -->
      <visual name="cuerpo">
        <geometry>
          <box><size>0.2 0.2 0.2</size></box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Cara frontal con el marcador ArUco, ligeramente
           desplazada hacia afuera para evitar z-fighting con "cuerpo" -->
      <visual name="cara_aruco">
        <pose>0.101 0 0 1.5708 0 1.5708</pose>
        <geometry>
          <plane><size>0.2 0.2</size></plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_23.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/cubo_aruco/cmd_vel</topic>
    </plugin>
  </model>
</sdf>