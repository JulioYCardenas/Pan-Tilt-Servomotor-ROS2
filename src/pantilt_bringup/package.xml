<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pantilt_bringup</name>
  <version>0.1.0</version>
  <description>Launch que levanta la simulacion completa del pan-tilt</description>
  <maintainer email="julioyaelcar@gmail.com">Julio Y. Cárdenas</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>pantilt_description</exec_depend>
  <exec_depend>pantilt_gazebo</exec_depend>
  <exec_depend>pantilt_vision</exec_depend>
  <exec_depend>pantilt_control</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>